{
  "headers": [
    {
      "source": "/forests.geojson",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/geo+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/geo+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data/forests.geojson",
      "destination": "/forests.geojson"
    }
  ]
}