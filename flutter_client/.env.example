# Конфігурація збірки. Скопіюйте у flutter_client/.env (не комітиться — див. кореневий .gitignore)
# і запускайте:  flutter run --dart-define-from-file=.env
# Тільки публічні значення: URL проєкту і publishable (anon) key. НІКОЛИ не service_role.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
